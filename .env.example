# Agent-Whatsapp — configurações
#
# Jeito fácil: rode `python3 instalar.py` e responda as perguntas — ele preenche este arquivo pra você.
# Jeito manual: copie este arquivo com o nome `.env` e preencha. NÃO versione o .env (já no .gitignore).
# Comentário vai sempre em linha própria, começando com #. Texto que tenha # dentro vai entre aspas.

# ─── Zappfy ───────────────────────────────────────────────────────
# API de WhatsApp usada pelo agente. Sem conta? https://zappfy.io (passo a passo: COMO-INSTALAR.md, seção 1.1)
# ZAPPFY_TOKEN = campo "API Key" do card da instância em https://dash.zappfy.io/dashboard
ZAPPFY_TOKEN=cole-aqui-a-api-key-da-sua-instancia
# Seu WhatsApp pessoal, só números, com 55 + DDD. É pra ele que vão as mensagens de teste.
TEST_NUMBER=5511999998888
API_BASE=https://api.zappfy.io
# (opcional) OPERATOR_NUMBER — padrão: igual ao TEST_NUMBER. Usado pra saber em quais grupos você é admin.
# OPERATOR_NUMBER=5511999998888

# ─── Textos prontos: preencha as lacunas ──────────────────────────
# Os textos prontos de follow-up e de resposta automática têm lacunas ([TEMA], [PRODUTO]...).
# O agente troca cada lacuna pelo valor abaixo. Enquanto o valor estiver vazio, a mensagem que
# depende dele NÃO é enviada — assim nunca chega "[TEMA]" no WhatsApp do seu cliente.
# [SUA EMPRESA] → nome da sua empresa (resposta automática de saudação)
MSG_EMPRESA=
# [TEMA] → assunto da conversa com o lead (cadências followup_padrao e pos_proposta)
MSG_TEMA=
# [BENEFÍCIO ESPECÍFICO] → um benefício concreto do que você vende (cadência followup_padrao)
MSG_BENEFICIO=
# [PRODUTO] → nome do produto (cadência recuperacao_carrinho)
MSG_PRODUTO=
# [NOVIDADE] e [LINK] → a novidade e o link dela (cadência reativacao)
MSG_NOVIDADE=
MSG_LINK=

# ─── Inbox ────────────────────────────────────────────────────────
# Webhook (opcional). Se preencher, a URL do webhook precisa terminar em ?token=<este valor>
WEBHOOK_TOKEN=

# Respostas automáticas (pode personalizar). \n = quebra de linha.
AUTO_REPLY_OPT_OUT=ok, parei. Você não vai mais receber mensagens nossas.
AUTO_REPLY_AGENDAMENTO=Boa! Agenda direto pelo link 👇\n{calendly}\n\nAssim sai certinho no horário que cabe pra você.
AUTO_REPLY_SAUDACAO=oi! tudo bem? Sou da [SUA EMPRESA]. Como posso te ajudar?

# ─── Agenda (Calendly / Cal.com) ──────────────────────────────────
# Link da sua agenda. O agente envia quando o lead quer marcar horário.
# Sem link, o agente só avisa você e não envia nada pro lead.
CALENDLY_URL=

# ─── Qualificação BANT (override pras 3 perguntas) ────────────────
QUALIFY_Q1=Oi {{first_name}}! Pergunta rápida pra entender se faz sentido — qual seu maior desafio hoje?
QUALIFY_Q2=E nessa decisão, você é quem decide ou tem alguém junto?
QUALIFY_Q3=Qual seu prazo pra resolver isso? (essa semana / esse mês / esse trimestre / sem pressa)
QUALIFY_DELAY_BETWEEN_Q=60

# ─── Followup ─────────────────────────────────────────────────────
FOLLOWUP_DELAY=75

# ─── Pipeline / Forecast ──────────────────────────────────────────
DEFAULT_TICKET=1000
